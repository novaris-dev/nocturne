{
    "name": "novaris-dev/nocturne",
    "description": "A starter project for building websites with the Novaris Content Management System.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Benjamin Lu"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": ">=8.2",
        "luthemes/ui": "dev-main",
        "novaris-dev/framework": "^1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/luthemes/ui"
        }
    ],
    "scripts": {
        "novaris": "php vendor/novaris-dev/framework/src/bin/novaris"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
